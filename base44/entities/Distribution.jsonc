{
  "name": "Distribution",
  "type": "object",
  "properties": {
    "campaign_idea_id": {
      "type": "string"
    },
    "campaign_title": {
      "type": "string"
    },
    "target_channels": {
      "type": "string",
      "description": "Comma separated channels dispatched to"
    },
    "rm_count": {
      "type": "number",
      "description": "Number of relationship managers receiving this"
    },
    "digital_reach": {
      "type": "number",
      "description": "Estimated customers reached via digital channels"
    },
    "message_ids": {
      "type": "string",
      "description": "Comma separated marketing message IDs included"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the campaign is scheduled to launch"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "dispatched",
        "failed"
      ],
      "default": "dispatched"
    },
    "dispatched_by": {
      "type": "string"
    },
    "ab_test": {
      "type": "boolean",
      "description": "Whether this dispatch runs as an A/B test",
      "default": false
    },
    "variant_a_message_id": {
      "type": "string",
      "description": "Marketing message used as Variant A"
    },
    "variant_b_message_id": {
      "type": "string",
      "description": "Marketing message used as Variant B"
    },
    "variant_split": {
      "type": "number",
      "description": "Percentage of traffic allocated to Variant A (1-99)",
      "default": 50
    },
    "winner_metric": {
      "type": "string",
      "enum": [
        "conversion_rate",
        "click_through_rate",
        "revenue"
      ],
      "description": "Metric used to decide the winning variant"
    }
  },
  "required": [
    "campaign_idea_id",
    "campaign_title",
    "target_channels"
  ]
}