{
  "name": "MarketEvent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title of the CIO insight"
    },
    "category": {
      "type": "string",
      "enum": [
        "regulatory",
        "economic",
        "competitor",
        "market",
        "geopolitical"
      ]
    },
    "description": {
      "type": "string",
      "description": "The Chief Investment Office's view and recommended client action"
    },
    "impact_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "affected_segments": {
      "type": "string",
      "description": "Comma separated customer segments affected"
    },
    "product_category": {
      "type": "string",
      "description": "Comma separated banking product categories the insight relates to (e.g. Wealth, Equities, Fixed Income, FX, Insurance)"
    },
    "source": {
      "type": "string",
      "description": "Origin of the insight, e.g. Chief Investment Office Weekly Outlook"
    },
    "event_date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "monitoring",
        "actioned"
      ],
      "default": "new"
    }
  },
  "required": [
    "title",
    "category",
    "description",
    "impact_level"
  ]
}